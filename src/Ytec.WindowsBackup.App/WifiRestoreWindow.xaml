<Window x:Class="Ytec.WindowsBackup.App.WifiRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WifiWindowTitle}"
        Width="900"
        Height="610"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,28">
            <Border Style="{StaticResource PageHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{StaticResource MintGradientBrush}"
                            CornerRadius="16">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Text="2" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleStyle}"
                                   Text="{DynamicResource WifiTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                   Text="{DynamicResource WifiSubtitle}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Padding="16,8"
                            Content="{DynamicResource BackButton}"
                            Click="Back_Click" />
                </Grid>
            </Border>

            <Border Margin="0,16,0,14"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingStyle}"
                               Text="{DynamicResource WifiSection1}" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{DynamicResource WifiFolderHint}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupJobTextBox"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="{DynamicResource WifiFolderAutomation}" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="18,6"
                                Content="{DynamicResource SelectRootFolderButton}"
                                Click="Browse_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,14"
                    Style="{StaticResource WarningCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FFE5AE"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningDarkBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="Bold"
                                   Foreground="{StaticResource WarningDarkBrush}"
                                   Text="{DynamicResource WifiWarningHeading}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource WarningDarkBrush}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource WifiWarningOverwrite}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource WarningDarkBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource WifiWarningAnalysis}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DevelopmentBuildWarning"
                    Margin="0,0,0,14"
                    Style="{StaticResource WarningCardStyle}"
                    Visibility="Collapsed">
                <TextBlock Foreground="{StaticResource WarningDarkBrush}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource WifiDevelopmentWarning}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingStyle}"
                               Text="{DynamicResource WifiSection2}" />
                    <ProgressBar x:Name="RestoreProgressBar"
                                 Margin="0,16,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 AutomationProperties.Name="{DynamicResource WifiProgressAutomation}"
                                 Foreground="{StaticResource MintGradientBrush}" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               AutomationProperties.Name="{DynamicResource WifiStatusAutomation}"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{DynamicResource WifiSelectRootInitial}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RestoreButton"
                                Style="{StaticResource MintPrimaryButtonStyle}"
                                Content="{DynamicResource WifiRestoreButton}"
                                IsEnabled="False"
                                Click="Restore_Click" />
                        <Button x:Name="CancelButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="{DynamicResource CancelButton}"
                                IsEnabled="False"
                                Click="Cancel_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
