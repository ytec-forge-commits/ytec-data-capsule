<Window x:Class="Ytec.WindowsBackup.App.BookmarkRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource BookmarkWindowTitle}"
        Width="960"
        Height="680"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,28">
            <Border Style="{StaticResource PageHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{StaticResource PurpleGradientBrush}"
                            CornerRadius="16">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Text="3" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleStyle}"
                                   Text="{DynamicResource BookmarkTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                   Text="{DynamicResource BookmarkSubtitle}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Padding="16,8"
                            Content="{DynamicResource BackButton}"
                            Click="Back_Click" />
                </Grid>
            </Border>

            <Border Margin="0,16,0,14"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingStyle}"
                               Text="{DynamicResource BookmarkSection1}" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{DynamicResource BookmarkFolderHint}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupJobTextBox"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="{DynamicResource BookmarkFolderAutomation}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="18,6"
                                Content="{DynamicResource SelectRootFolderButton}"
                                Click="BrowseBackup_Click" />
                    </Grid>
                    <TextBlock x:Name="DiscoveryStatusText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{DynamicResource BookmarkSelectInitial}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingStyle}"
                               Text="{DynamicResource BookmarkSection2}" />
                    <ComboBox x:Name="BackupEntryComboBox"
                              Margin="0,13,0,0"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="{DynamicResource BookmarkListAutomation}"
                              SelectionChanged="BackupEntry_SelectionChanged" />

                    <StackPanel x:Name="ChromiumTargetPanel"
                                Margin="0,14,0,0"
                                Visibility="Collapsed">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="{DynamicResource BookmarkTargetHeading}" />
                        <ComboBox x:Name="TargetComboBox"
                                  Margin="0,7,0,0"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{DynamicResource BookmarkTargetAutomation}"
                                  SelectionChanged="Target_SelectionChanged" />
                    </StackPanel>

                    <Border x:Name="FirefoxInstructionPanel"
                            Margin="0,14,0,0"
                            Padding="13"
                            Background="{StaticResource PurpleSoftBrush}"
                            BorderBrush="#D7C5F2"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource PurpleDarkBrush}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource BookmarkFirefoxHelp}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,14"
                    Style="{StaticResource WarningCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FFE5AE"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningDarkBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="!" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Foreground="{StaticResource WarningDarkBrush}"
                               TextWrapping="Wrap"
                               Text="{DynamicResource BookmarkSafetyWarning}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingStyle}"
                               Text="{DynamicResource BookmarkSection3}" />
                    <ProgressBar x:Name="RestoreProgressBar"
                                 Margin="0,14,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 AutomationProperties.Name="{DynamicResource BookmarkProgressAutomation}"
                                 Foreground="{StaticResource PurpleGradientBrush}" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               AutomationProperties.Name="{DynamicResource BookmarkStatusAutomation}"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{DynamicResource BookmarkSelectInitial}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RestoreButton"
                                Style="{StaticResource PurplePrimaryButtonStyle}"
                                Content="{DynamicResource BookmarkRestoreButton}"
                                IsEnabled="False"
                                Click="Restore_Click" />
                        <Button x:Name="CancelButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="{DynamicResource CancelButton}"
                                IsEnabled="False"
                                Click="Cancel_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
